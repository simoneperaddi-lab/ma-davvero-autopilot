# Demo: no credentials required. Copy to .env; never commit real credentials.
MAD_PROVIDER=demo
MAD_STORAGE=sqlite
MAD_DATA_DIR=./data
# Explicit opt-out for local demo ONLY. The application's default is basic auth.
# Never use local mode behind a reverse proxy or on a public interface.
MAD_AUTH_MODE=local
MAD_AUTH_USERNAME=editor
MAD_AUTH_PASSWORD=
MAD_PUBLIC_ORIGIN=
MAD_RATE_PER_MINUTE=120
MAD_GENERATE_PER_MINUTE=6
MAD_EXPORT_PER_MINUTE=4
MAD_RESEARCH_PER_MINUTE=10
# For MAD_PROVIDER=openai, set the key securely in your environment.
OPENAI_API_KEY=
MAD_OPENAI_MODEL=gpt-4.1-mini
# No paid calls until explicitly enabled, priced AND budgeted. Keep off in tests.
MAD_PAID_ENABLED=false
MAD_OPENAI_DAILY_CALLS=0
MAD_OPENAI_DAILY_BUDGET_USD=0
MAD_OPENAI_CALL_CEILING_USD=0
MAD_OPENAI_INPUT_USD_PER_MILLION=0
MAD_OPENAI_OUTPUT_USD_PER_MILLION=0
# For MAD_STORAGE=supabase, apply supabase/schema.sql first.
# Backend-only service role key, never expose it in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
