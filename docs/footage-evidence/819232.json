    "rendered": "<div style=\"width: 1024px;\" class=\"wp-video\"><video class=\"wp-video-shortcode\" id=\"video-819232-1\" width=\"1024\" height=\"1024\" preload=\"metadata\" controls=\"controls\"><source type=\"video/mp4\" src=\"https://www.nasa.gov/wp-content/uploads/2025/02/20240506110746-1024-aia-0131.mp4?_=1\" /><a href=\"https://www.nasa.gov/wp-content/uploads/2025/02/20240506110746-1024-aia-0131.mp4\">https://www.nasa.gov/wp-content/uploads/2025/02/20240506110746-1024-aia-0131.mp4</a></video></div>\n"
